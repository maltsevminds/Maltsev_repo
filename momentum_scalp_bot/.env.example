# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Binance USDⓈ-M Futures TESTNET keys (https://testnet.binancefuture.com) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Bybit TESTNET keys (https://testnet.bybit.com -> API Management) ---
# Used with: --mode testnet --config config.bybit.testnet.yaml
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# --- Binance USDⓈ-M Futures LIVE keys (real money — keep secret!) ---
# Only used when mode=live AND confirm_live=true in config.yaml.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram alerts (optional) ---
# Create a bot with @BotFather, then get chat_id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
